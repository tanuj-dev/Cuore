<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- HealthKit, read-only. Must also be enabled on the com.cuore App ID in the Apple
	     Developer portal and the provisioning profiles regenerated, or signing fails.
	     Deliberately NOT adding com.apple.developer.healthkit.access: that key is for
	     Clinical Health Records, which is a separate and much heavier App Review. -->
	<!-- Universal links for https://cuore.health/app/* (WhatsApp consultation + booking
	     links). Requires the Associated Domains capability on the com.cuore App ID and an
	     apple-app-site-association file served from https://cuore.health. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:cuore.health</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
